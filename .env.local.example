# ════════════════════════════════════════════════════════════════
# EduGen - Multi-LLM Configuration
# ════════════════════════════════════════════════════════════════
#
# הוראות התקנה:
# 1. שנה שם קובץ זה ל- .env.local (הסר את .example)
# 2. הוסף את ה-API keys שלך למטה
# 3. תוכל להשתמש באחד מהספקים או בשניהם
#
# ════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# Google Gemini API
# ─────────────────────────────────────────────────────────────────
# להשגת API Key:
# 1. היכנס ל- https://aistudio.google.com/apikey
# 2. צור API Key חדש (בחינם!)
# 3. העתק והדבק כאן
#
# מודלים זמינים:
# - gemini-2.5-flash (מומלץ - מהיר וזול)
# - gemini-2.5-pro (חזק יותר, יקר יותר)
#
# עלות: ~$0.075 למדריך
# ─────────────────────────────────────────────────────────────────

GEMINI_API_KEY=your_gemini_api_key_here


# ─────────────────────────────────────────────────────────────────
# OpenRouter API (גישה למגוון רחב של מודלים)
# ─────────────────────────────────────────────────────────────────
# להשגת API Key:
# 1. היכנס ל- https://openrouter.ai/
# 2. הירשם/התחבר
# 3. לך ל- https://openrouter.ai/keys
# 4. צור API Key חדש
# 5. העתק והדבק כאן
#
# מודלים זמינים דרך OpenRouter (דוגמאות):
#
# ** DeepSeek (מומלץ מאוד - איכות גבוהה + זול!) **
# - deepseek/deepseek-chat (~$0.01 למדריך)
# - deepseek/deepseek-r1 (מודל reasoning חזק)
#
# ** OpenAI **
# - openai/gpt-4o (~$0.30 למדריך)
# - openai/gpt-4o-mini (~$0.05 למדריך)
#
# ** Anthropic Claude **
# - anthropic/claude-3.5-sonnet (מצוין לכתיבה יצירתית)
# - anthropic/claude-3-haiku (מהיר וזול)
#
# ** Meta Llama **
# - meta-llama/llama-3.3-70b-instruct (קוד פתוח, איכותי)
#
# ** Mistral **
# - mistralai/mistral-large (מודל אירופאי חזק)
#
# ** Alibaba Qwen **
# - qwen/qwen-2.5-72b-instruct (מצוין לשפות רבות)
#
# ** Google via OpenRouter **
# - google/gemini-2.0-flash-exp:free (חינם!)
#
# ─────────────────────────────────────────────────────────────────

OPENROUTER_API_KEY=your_openrouter_api_key_here


# ─────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────

SERVER_PORT=5000

# ─────────────────────────────────────────────────────────────────
# Client Configuration
# ─────────────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:5000


# ════════════════════════════════════════════════════════════════
# 💡 טיפים:
# ════════════════════════════════════════════════════════════════
#
# 1. אתה יכול להשתמש ביותר מספק אחד (הגדר שני ה-API Keys)
# 2. DeepSeek הוא הבחירה הכלכלית ביותר בעוד שמירה על איכות גבוהה
# 3. Gemini Flash מומלץ לשימוש ישראלי (תמיכה טובה בעברית)
# 4. OpenRouter נותן לך גישה ל-50+ מודלים עם API אחד!
# 5. תמיד התחל עם מודלים זולים לבדיקות (DeepSeek/Gemini Flash)
#
# ════════════════════════════════════════════════════════════════
